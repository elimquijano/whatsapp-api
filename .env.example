# Configuración del Servidor (Backend)
PORT=3000
NODE_ENV=development

# Configuración del Frontend (Vite)
VITE_PORT=3001
# URL pública real del backend. Déjala vacía si frontend y API comparten origen.
VITE_API_URL=

# Base de Datos (MySQL)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=whatsapp_sessions_db

# Seguridad JWT
# Genera una clave larga y aleatoria para producción
JWT_SECRET=super_secret_key_for_saas_platform_2024
# No cambies esta clave después de guardar tokens de IA o integraciones.
AI_CREDENTIALS_SECRET=otra_clave_larga_y_aleatoria_para_cifrar_credenciales

# Directorio privado para multimedia de campanas (opcional).
# Si se omite, se usa ./uploads/campaign-media. No debe servirse como carpeta publica.
CAMPAIGN_MEDIA_DIR=./uploads/campaign-media
# Cuota conjunta del directorio anterior en MB. Valor predeterminado: 1024 (1 GB).
CAMPAIGN_MEDIA_MAX_STORAGE_MB=1024

# Seguridad de URLs usadas por importaciones CRM y multimedia remota.
# Lista exacta, separada por comas, de hosts privados que esta instalacion necesita consultar.
# Ejemplo: crm.intranet.local,10.0.0.25. Dejala vacia para bloquearlos todos.
HTTP_INTEGRATION_ALLOWED_HOSTS=
# Solo para instalaciones administradas dentro de una red confiable. En true permite cualquier
# IP privada/local; se recomienda mantener false y usar la lista exacta anterior.
HTTP_INTEGRATION_ALLOW_PRIVATE=false

# Hosts adicionales autorizados para proveedores de IA personalizados (separados por comas).
# OpenAI, Groq y Gemini oficiales ya funcionan sin agregarlos. Esta excepción también
# permite HTTP/red privada para el host exacto, así que debe usarse solo con gateways propios.
AI_PROVIDER_ALLOWED_HOSTS=

# Credenciales del Administrador Maestro (Primer inicio)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@tusaaS.com
INITIAL_ADMIN_PASSWORD=password_maestro_123
